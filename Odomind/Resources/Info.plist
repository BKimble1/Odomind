<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Odomind</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The branded launch screen: the emblem on white, centred, static.
	     No progress bar, no animation, no network. The app's own
	     LaunchBrandingView reproduces this exactly while the local store
	     opens, adding the "Powered by Idlery" line the native launch screen
	     has no way to draw, and hands over the moment state is ready. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchEmblem</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Requested only when the owner scans a VIN, never at launch. -->
	<key>NSCameraUsageDescription</key>
	<string>Odomind uses the camera to read the VIN plate on your vehicle so you do not have to type 17 characters. Nothing is recorded or uploaded, and you can always type the VIN instead.</string>

	<!-- Write-only, because writing is all Odomind does. A single event goes
	     through the system editor, which has its own access; a reviewed batch
	     export asks for this. Odomind never reads the calendar, so it cannot
	     tell you what is already on it and does not claim to. -->
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Odomind adds maintenance dates you choose to your calendar. You see exactly what will be added first. It never reads your calendar and never removes anything.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Odomind attaches photos of receipts to your service records. They stay on this device.</string>

	<!-- Only if the owner asks for parts shops near them, and never for
	     maintenance itself: typing a postal code does the same job. Requested
	     at kilometre accuracy, because the nearest shops are all this needs
	     and a street-level fix is more than it should hold. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Odomind uses your approximate location only to list parts shops near you, and only when you ask. You can type a postal code instead, and nothing about your vehicle is sent with it.</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.idlery.odomind.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>odomind</string>
			</array>
		</dict>
	</array>

	<key>UIBackgroundModes</key>
	<array/>
</dict>
</plist>
